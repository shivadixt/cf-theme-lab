{
  "manifest_version": 3,
  "name": "Codeforces — Bauhaus & Papercut",
  "short_name": "CF Theme Lab",
  "version": "1.0.0",
  "description": "Bauhaus and Papercut themes for Codeforces with a quick switcher and refined tags, comments, and testcase styling.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://*.codeforces.com/*",
    "https://codeforces.org/*",
    "https://*.codeforces.org/*"
  ],
  "action": {
    "default_title": "CF Theme Lab — Change Codeforces theme",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://*.codeforces.com/*",
        "https://codeforces.org/*",
        "https://*.codeforces.org/*"
      ],
      "css": [
        "styles/themes.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
